# Copy to .env and fill in. Never commit .env.

ENVIRONMENT=development
DEBUG=true

# Port 5433 matches docker-compose.yml, which avoids a locally installed PostgreSQL.
DATABASE_URL=postgresql+asyncpg://simumarket:simumarket@localhost:5433/simumarket
REDIS_URL=redis://localhost:6379/0

# Generate a unique value for every non-local environment, for example with
# `python -c "import secrets; print(secrets.token_hex(32))"`.
JWT_SECRET=development-only-change-me
JWT_ISSUER=simumarket-ai
JWT_AUDIENCE=simumarket-ai-web
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
AUTH_COOKIE_SECURE=false

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Provider credentials. While this is empty the analysis pipeline still runs and
# finishes as `partial`: the simulation section states that no provider key is
# configured rather than inventing agent output.
GEMINI_API_KEY=

# Celery. Both default to REDIS_URL when left empty.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_ANALYSIS_QUEUE=analysis
CELERY_ANALYSIS_SOFT_TIME_LIMIT_SECONDS=600
CELERY_ANALYSIS_TIME_LIMIT_SECONDS=900
# Runs tasks inline instead of queueing them. Development and test only.
CELERY_TASK_ALWAYS_EAGER=false

# OASIS. Models tagged `-preview` are rejected at startup: they can change
# without notice, which would invalidate every comparison recorded against a run
# manifest. See Docs/docs/14.
OASIS_ENABLED=true
OASIS_MODEL_ID=gemini-3.1-flash-lite
OASIS_PROMPT_VERSION=oasis-council-v1
OASIS_COHORT_VERSION=jabodetabek-fnb-v1
OASIS_SEED=42
# docs/04 fixes the cohort at 12-24 personas across four archetypes.
OASIS_COHORT_SIZE=16
OASIS_ROUND_LIMIT=4
# Hard budgets. Every one of them actually stops a run.
OASIS_TOKEN_BUDGET=120000
OASIS_MAX_OUTPUT_TOKENS_PER_STAGE=1024
OASIS_CONCURRENCY_LIMIT=4
OASIS_WALL_CLOCK_SECONDS=240
OASIS_RETRY_LIMIT=1
# One directory per run is created under this root and never deleted implicitly.
OASIS_TRACE_ROOT=var/oasis-traces
OASIS_TRACE_RETENTION_DAYS=30

# Server-sent events for analysis progress.
SSE_HEARTBEAT_SECONDS=15
SSE_POLL_INTERVAL_SECONDS=2
SSE_MAX_DURATION_SECONDS=900
